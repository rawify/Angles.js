{
    "name": "angles",
    "title": "Angles.js",
    "version": "0.6.0",
    "type": "commonjs",
    "description": "Angle normalization, conversion, interpolation, circular mean, distance, and compass helpers for JavaScript",
    "homepage": "https://github.com/rawify/Angles.js",
    "bugs": "https://github.com/rawify/Angles.js/issues",
    "keywords": [
        "degree",
        "degrees",
        "convert",
        "lerp",
        "radians",
        "direction",
        "geo",
        "compass",
        "cardinal",
        "slope",
        "angle",
        "angles",
        "angular",
        "average",
        "mean",
        "between"
    ],
    "private": false,
    "main": "./dist/angles.js",
    "module": "./dist/angles.mjs",
    "browser": "./dist/angles.min.js",
    "unpkg": "./dist/angles.min.js",
    "types": "./dist/angles.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "import": {
                "types": "./dist/angles.d.mts",
                "default": "./dist/angles.mjs"
            },
            "require": {
                "types": "./dist/angles.d.ts",
                "default": "./dist/angles.js"
            },
            "default": {
                "types": "./dist/angles.d.ts",
                "default": "./dist/angles.js"
            }
        },
        "./browser": {
            "import": {
                "types": "./dist/angles.d.mts",
                "default": "./dist/angles.min.mjs"
            },
            "default": "./dist/angles.min.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rawify/Angles.js.git"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/rawify"
    },
    "author": {
        "name": "Robert Eisele",
        "email": "robert@raw.org",
        "url": "https://raw.org/"
    },
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "directories": {
        "test": "tests"
    },
    "scripts": {
        "clean": "node scripts/clean.mjs",
        "typecheck": "tsc --noEmit",
        "build": "node scripts/build.mjs",
        "test:types": "tsc -p tests/types/tsconfig.json",
        "test:runtime": "node --test tests/*.test.js",
        "test": "npm run typecheck && npm run build && npm run test:types && npm run test:runtime",
        "prepublishOnly": "npm test"
    },
    "devDependencies": {
        "esbuild": "^0.25.12",
        "typescript": "^5.9.3"
    }
}
